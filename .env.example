# Copy to .env and fill in. Never commit .env.
POSTGRES_DOC_VERSION=17

# LLM provider (OpenAI-compatible endpoint). Swap provider by changing these only.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_ID=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Embeddings (local)
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# Agent loop limits
MAX_GRAPH_STEPS=8
MAX_TOOL_CALLS=8
MAX_WALL_CLOCK_SECONDS=90

# Infra
REDIS_URL=redis://redis:6379/0
CHROMA_HOST=chroma
CHROMA_PORT=8000
DATA_DIR=/app/data

# Rate limiting
RATE_LIMIT_PER_MINUTE=10
MAX_QUEUE_DEPTH=50

# Testing
USE_LLM_STUB=false
